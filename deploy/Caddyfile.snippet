
modelbehavior.report {
	encode zstd gzip
	root * /var/www/modelbehavior
	# Password-protect the pipeline/cost page. Hash: `caddy hash-password`.
	basicauth /status/* {
		admin <bcrypt-hash>
	}
	reverse_proxy /status/api/* 127.0.0.1:3004
	header Cache-Control "public, max-age=300"
	file_server
}
www.modelbehavior.report {
	redir https://modelbehavior.report{uri} permanent
}
